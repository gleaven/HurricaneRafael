{
 "about": "Data streams in this package. Times are UTC unless a column name says local; local time is US Central (UTC-5 until 2027-11-07 07:00Z, UTC-6 after). Paths are relative to the package root.",
 "streams": [
  {
   "stream_id": "ais",
   "name": "AIS vessel positions",
   "path": "data/ais/*.csv",
   "more_files": [
    "data/ais/satellite/sais_*.csv"
   ],
   "format": "USCG NAIS / MarineCadastre CSV",
   "key_columns": {
    "time": "BaseDateTime (UTC)",
    "entity_ids": [
     "MMSI",
     "IMO",
     "VesselName"
    ],
    "location": [
     "LAT",
     "LON"
    ]
   },
   "ids_join_to": [
    "vessels.json"
   ],
   "cadence": "about 1 min in channels and harbours, 5 min in open bay and approaches, 6 min at anchor, 15 min on station, 30 min offshore, 60 min moored"
  },
  {
   "stream_id": "port_surveillance",
   "name": "Port radar and camera contact log",
   "path": "data/port_surveillance/*.csv",
   "more_files": [],
   "format": "Radar track table (sensor id, track id, time, position, speed, course, AIS-correlated flag, correlated MMSI) and camera event log",
   "key_columns": {
    "time": "time_utc",
    "entity_ids": [
     "sensor_id",
     "track_id",
     "correlated_mmsi"
    ],
    "location": [
     "latitude",
     "longitude"
    ]
   },
   "ids_join_to": [
    "sensor_registry.json",
    "vessels.json",
    "terminal_registry.json"
   ],
   "cadence": "radar tracks every 1-2 min while a contact is held; camera events as they occur; sensor status rows hourly"
  },
  {
   "stream_id": "port_conditions",
   "name": "Coast Guard port conditions and channel status",
