{
  "schema_version": "1.0",
  "note": "Material quantities news may state, with the day each value becomes public. Patterns capture the number in group 1. Add a value here only when the public record supports it.",
  "rules": [
    {
      "name": "barrels spilled",
      "pattern": "\\b([\\d,]+(?:\\.\\d+)?)\\s+barrels\\b",
      "allowed": [
        {
          "value": 9000,
          "from_day": 1
        }
      ]
    },
    {
      "name": "surge height (feet)",
      "pattern": "\\b(\\d+(?:\\.\\d+)?)\\s*(?:to\\s*\\d+\\s*)?(?:feet|foot|ft)\\b(?=[^.]{0,30}\\bsurge)",
      "allowed": [
        {
          "value": 9,
          "from_day": -2
        },
        {
          "value": 11,
          "from_day": 0
        }
      ]
    },
    {
      "name": "surge height (feet), range end",
