{
 "note": "Every source of positions in the corpus and the geographic rule it must satisfy. scripts/check_geo.py reads this. Add an entry whenever a stream with coordinates is added.",
 "sources": [
  {
   "name": "AIS vessel positions",
   "glob": "05_other_sources/ais/*.csv",
   "lat": "LAT",
   "lon": "LON",
   "rule": "vessel",
   "id": "MMSI",
   "time": "BaseDateTime",
   "draft_m": "Draft"
  },
  {
   "name": "ADS-B ground positions",
   "glob": "05_other_sources/adsb/*.csv",
   "lat": "latitude",
   "lon": "longitude",
   "rule": "aircraft_ground",
   "id": "callsign",
   "ground": "on_ground"
  },
  {
   "name": "911 incident locations",
   "glob": "05_other_sources/911/*.csv",
   "lat": "latitude",
   "lon": "longitude",
   "rule": "incident",
   "id": "incident_number"
  },
  {
   "name": "Damage assessment structures",
   "glob": "05_other_sources/infrastructure/*.csv",
   "lat": "LATITUDE",
   "lon": "LONGITUDE",
   "rule": "land_fixed",
   "id": "structure_id"
  },
  {
   "name": "Air monitors",
   "glob": "05_other_sources/env_sensors/aqs_*.csv",
   "lat": "Latitude",
   "lon": "Longitude",
   "rule": "land_fixed",
   "id": "AQS_Site_ID",
   "allow_missing": true
  },
  {
   "name": "Water-quality sondes",
   "glob": "05_other_sources/env_sensors/water_quality_*.csv",
   "lat": "Latitude",
   "lon": "Longitude",
   "rule": "water_fixed",
   "id": "SensorID",
   "shore_ok": true
  },
  {
   "name": "Weather stations",
   "glob": "05_other_sources/weather/*ASOS*.csv",
   "lat": "StnLat",
   "lon": "StnLon",
   "rule": "land_fixed",
   "id": "StationName"
  },
  {
   "name": "Vehicle locations (AVL)",
   "glob": "05_other_sources/avl/*.csv",
   "lat": "latitude",
   "lon": "longitude",
   "rule": "vehicle",
   "id": "unit_id",
   "optional": true
  },
  {
   "name": "Registry: facilities",
   "glob": "06_data_streams/facility_registry.json",
   "items": "facilities",
   "lat": "latitude",
   "lon": "longitude",
   "rule": "land_fixed",
   "id": "facility_id"
  },
  {
   "name": "Registry: infrastructure",
   "glob": "06_data_streams/infrastructure_assets.json",
   "items": "assets",
   "lat": "latitude",
   "lon": "longitude",
   "rule": "land_fixed",
   "id": "asset_id"
  },
  {
   "name": "Registry: air monitors",
   "glob": "06_data_streams/sensor_registry.json",
   "items": "air_monitors",
   "lat": "latitude",
   "lon": "longitude",
   "rule": "land_fixed",
   "id": "sensor_id"
  },
  {
   "name": "Registry: weather stations",
   "glob": "06_data_streams/sensor_registry.json",
   "items": "weather_stations",
   "lat": "latitude",
   "lon": "longitude",
   "rule": "land_fixed",
   "id": "sensor_id"
  },
  {
   "name": "Registry: tide gauges",
   "glob": "06_data_streams/sensor_registry.json",
   "items": "tide_gauges",
   "lat": "latitude",
   "lon": "longitude",
   "rule": "water_fixed",
   "id": "sensor_id",
   "shore_ok": true
  },
  {
   "name": "Registry: sondes",
   "glob": "06_data_streams/sensor_registry.json",
