{
  "family": "utility / OT (scada_historian, outage_map, work_orders, base_status_reports, fuel_deliveries, vessel_ot_logs)",
  "changes": [
    {
      "stream_id": "scada_historian",
      "field": "cadence",
      "now": "compressed archive: row on change beyond deadband, at least hourly (15 min for key pressures and voltages); events at the exact second",
      "was": "1-5 min by tag",
      "why": "331 tags over 150 days at 1-5 min is 0.8-4 GB; the compressed archive is 60 MB and keeps every event"
    },
    {
      "stream_id": "scada_historian",
      "field": "key_columns",
      "now": {
        "time": "Timestamp (UTC)",
        "entity_ids": [
          "Tagname"
        ]
      },
      "was": {
        "time": "timestamp (UTC)",
        "entity_ids": [
          "tag",
          "asset"
        ]
      },
      "why": "export format in scada_tags.json is Tagname,Timestamp,Value,Quality; asset comes from the tag catalogue"
    },
    {
      "stream_id": "outage_map",
      "field": "cadence",
      "now": "15 min",
      "was": "hourly"
    },
    {
