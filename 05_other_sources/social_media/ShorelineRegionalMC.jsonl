{"created_at":"Tue Sep 14 19:00:10 +0000 2027","id":2231845513980674272,"id_str":"2231845513980674272","full_text":"Shoreline Regional Medical Center is operating under its hurricane contingency plan. The emergency department is open. Visitor access is restricted.","truncated":false,"entities":{"hashtags":[],"user_mentions":[],"urls":[]},"source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","in_reply_to_status_id_str":null,"in_reply_to_user_id_str":null,"in_reply_to_screen_name":null,"user":{"id":109778911,"id_str":"109778911","name":"Shoreline Regional Medical Center","screen_name":"ShorelineRegionalMC","location":"Corpus Christi, TX","description":"Level II trauma centre serving the Coastal Bend.","verified":true,"followers_count":10524,"friends_count":2652,"statuses_count":957,"created_at":"Tue Feb 14 01:04:18 +0000 2012"},"coordinates":null,"place":null,"is_quote_status":false,"retweet_count":16,"favorite_count":30,"lang":"en"}
{"created_at":"Thu Sep 16 16:00:09 +0000 2027","id":2232524985494276741,"id_str":"2232524985494276741","full_text":"Shoreline Regional has reached maximum patient capacity and is operating above its licensed bed count. Additional care areas are open. We are on generator power and have requested state and federal medical support.","truncated":false,"entities":{"hashtags":[],"user_mentions":[],"urls":[]},"source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","in_reply_to_status_id_str":null,"in_reply_to_user_id_str":null,"in_reply_to_screen_name":null,"user":{"id":109778911,"id_str":"109778911","name":"Shoreline Regional Medical Center","screen_name":"ShorelineRegionalMC","location":"Corpus Christi, TX","description":"Level II trauma centre serving the Coastal Bend.","verified":true,"followers_count":10939,"friends_count":2649,"statuses_count":958,"created_at":"Tue Feb 14 01:04:18 +0000 2012"},"coordinates":null,"place":null,"is_quote_status":false,"retweet_count":17,"favorite_count":32,"lang":"en"}
{"created_at":"Wed Sep 22 17:00:42 +0000 2027","id":2234714552042393593,"id_str":"2234714552042393593","full_text":"Our emergency department is seeing many patients with stomach illness. Hallway beds are in use. For mild symptoms, use urgent care and drink safe fluids.","truncated":false,"entities":{"hashtags":[],"user_mentions":[],"urls":[]},"source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","in_reply_to_status_id_str":null,"in_reply_to_user_id_str":null,"in_reply_to_screen_name":null,"user":{"id":109778911,"id_str":"109778911","name":"Shoreline Regional Medical Center","screen_name":"ShorelineRegionalMC","location":"Corpus Christi, TX","description":"Level II trauma centre serving the Coastal Bend.","verified":true,"followers_count":12139,"friends_count":2649,"statuses_count":959,"created_at":"Tue Feb 14 01:04:18 +0000 2012"},"coordinates":null,"place":null,"is_quote_status":false,"retweet_count":29,"favorite_count":29,"lang":"en"}
